---
import Navbar from "@/components/navbar.astro";

import TopSection from "@/components/top-section.astro";
import "@/styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/assets/images/logo.png" />
    <meta name="generator" content={Astro.generator} />
    <title>CAS TMSY</title>
  </head>
  <body>
    <div class="border-b-4 border-primary pb-4">
      <div class="max-w-7xl mx-auto">
        <TopSection />
        <Navbar />
      </div>
    </div>

    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
