---
const googleMapSrc =
  "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3151.83543450989!2d144.95373631531692!3d-37.816279779751554!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6ad642af0f11fd81%3A0xf5773651c4c11c4!2sYour%20College%20Name!5e0!3m2!1sen!2sus!4v1611810091234!5m2!1sen!2sus";
---

<div class="max-w-7xl mx-auto px-6 py-12">
  <h1 class="text-3xl font-bold text-gray-900 text-center">Contact Us</h1>

  <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-8">
    <!-- Contact Information -->
    <div>
      <h2 class="text-xl font-semibold">Get in Touch</h2>
      <p class="mt-2 text-gray-600">
        Feel free to reach out to us through the following contact details:
      </p>
      <ul class="mt-4 space-y-2 text-gray-700">
        <li><strong>Address:</strong> 123 College Road, City, Country</li>
        <li><strong>Phone:</strong> +123 456 7890</li>
        <li><strong>Email:</strong> contact@shardcncollege.edu</li>
      </ul>
    </div>

    <!-- Google Map Embed -->
    <div>
      <h2 class="text-xl font-semibold">Our Location</h2>
      <div class="mt-4 border rounded-lg overflow-hidden shadow-md">
        <iframe
          title="Google Map Location"
          class="w-full h-64 md:h-80"
          src={googleMapSrc}
          allowfullscreen=""
          loading="lazy"></iframe>
      </div>
    </div>
  </div>
</div>
