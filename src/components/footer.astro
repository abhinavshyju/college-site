---
import { Facebook, Linkedin, Twitter } from "lucide-react";
---

<div class="">
  <footer class="py-8 mt-10">
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <h2 class="text-xl font-bold">
          College of Applied Science, Thamarassery
        </h2>
        <p class="mt-2 text-gray-400">
          Empowering students with knowledge and skills for a brighter future.
        </p>
      </div>

      <div>
        <h3 class="text-lg font-semibold">Quick Links</h3>
        <ul class="mt-2 space-y-2 text-gray-400">
          <li>
            <a href="/about" class="hover:text-white"> About Us </a>
          </li>
          <li>
            <a href="/admissions" class="hover:text-white"> Admissions </a>
          </li>
          <li>
            <a href="/departments" class="hover:text-white"> Departments </a>
          </li>
          <li>
            <a href="/contact" class="hover:text-white"> Contact </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-lg font-semibold">Follow Us</h3>
        <div class="mt-2 flex space-x-4">
          <a href="#" class="text-gray-400 hover:text-white">
            <Facebook size={24} />
          </a>
          <a href="#" class="text-gray-400 hover:text-white">
            <Twitter size={24} />
          </a>
          <a href="#" class="text-gray-400 hover:text-white">
            <Linkedin size={24} />
          </a>
        </div>
      </div>
    </div>

    <div
      class="text-center text-gray-500 text-sm mt-6 border-t border-gray-700 pt-4"
    >
      &copy; {new Date().getFullYear()} CAS . All rights reserved.
    </div>
  </footer>
</div>
