---
const navLinks = [
  { title: "GALLERY", path: "/" },
  { title: "STUDENTS", path: "/" },
  { title: "COMMITTEES AND CELLS", path: "/" },
  { title: "College Resource", path: "/" },
  { title: "LOGINS", path: "/login" },
  { title: "Contact US", path: "/" },
];
---

<div
  class="grid sm:grid-cols-3 grid-cols-1 gap-2 items-center px-4 sm:p-0 py-2"
>
  <div class="flex flex-wrap gap-4 justify-evenly">
    <div class="flex hover:text-primary">+91 987654321</div>
    <div class="flex hover:text-primary">cas.tmsy@gmail.com</div>
  </div>
  <div class="col-span-2 w-full bg-primary rounded-b-md hidden sm:block">
    <div class="flex gap-2 justify-between px-4 text-white text-sm py-2">
      {
        navLinks.map((link) => (
          <a href={link.path} class="hover:text-yellow-500">
            {link.title}
          </a>
        ))
      }
    </div>
  </div>
</div>
