---
import { BookOpen, Building2, GraduationCap, Microscope } from "lucide-react";
---

<div class="relative">
  <div class="hidden grid-cols-4 absolute top-0 left-0 w-full h-full md:grid">
    <div class="col-span-1"></div>
    <div
      class="bg-gradient-to-r from-transparent via-white to-white col-span-2"
    >
    </div>
  </div>
  <div class="hidden md:grid grid-cols-5 w-full">
    <img
      src="/assets/images/college.jpg"
      alt=""
      class="aspect-video col-span-3 max-h-[500px] w-full object-cover"
    />
  </div>
  <div
    class="mt-4 md:absolute top-0 left-0 w-full h-full flex justify-center items-center"
  >
    <div class="grid md:grid-cols-2 max-w-7xl">
      <div class="col-start-2 px-8">
        <h1 class="font-bold md:text-xl">Welcome to</h1>
        <h2
          class="font-semibold text-xl md:text-2xl border-b-2 border-amber-400 pb-4"
        >
          College of Applied Science, Thamarassery
        </h2>
        <p class="mt-6 text-sm md:text-lg">
          Welcome to St. Teresa’s College, where we empower women to become
          innovative, compassionate leaders. With a rich history of academic
          excellence and a commitment to social responsibility, we provide a
          vibrant and inclusive community for our students. Explore our
          programs, events, and resources to discover how we can help you
          achieve your academic and personal goals.
        </p>
        <button
          class="bg-primary text-white px-4 py-2 hover:border border-primary hover:bg-white hover:text-primary mt-8"
          >Read More</button
        >
      </div>
    </div>
  </div>
