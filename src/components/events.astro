---
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";

const events = [
  {
    id: 1,
    title: "Annual Science Fair",
    date: "April 15, 2025",
    location: "Main Auditorium",
    description:
      "Showcasing innovative student projects and scientific breakthroughs.",
  },
  {
    id: 2,
    title: "Music Fest 2025",
    date: "May 10, 2025",
    location: "Open Ground",
    description:
      "A night filled with music, performances, and cultural activities.",
  },
  {
    id: 3,
    title: "Tech Symposium",
    date: "June 5, 2025",
    location: "Tech Hall, Block B",
    description:
      "Explore the latest trends in technology and networking opportunities.",
  },
];
---

<section class="max-w-7xl mx-auto px-6 py-12">
  <h2 class="text-2xl text-primary font-bold">Upcoming Events</h2>
  <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
    {
      events.map((event) => (
        <Card key={event.id} className="shadow-lg border rounded-lg">
          <CardHeader>
            <CardTitle>{event.title}</CardTitle>
          </CardHeader>
          <CardContent>
            <p class="text-gray-600 font-semibold">
              {event.date} - {event.location}
            </p>
            <p class="text-gray-700 mt-2">{event.description}</p>
          </CardContent>
        </Card>
      ))
    }
  </div>
</section>
