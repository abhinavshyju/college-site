---
import { TeachersList } from "@/components/react/TeachersCard";
import Layout from "@/layouts/Layout.astro";
export interface userType {
  name: string;
  post: string;
}
const staff: userType[] = [
  {
    name: "user one",
    post: "Test",
  },
];
---

<Layout>
  <div class="max-w-6xl mx-auto pt-10 pb-20">
    <h2 class="text-4xl text-center mb-10 text-gray-800">
      Department of Computer Science
    </h2>
    <p class="text-sm text-gray-700 mb-20">
      The Department of Computer Science, functioning from very beginning of the
      college. The students are assessed through continuous internal evaluation
      and examination conducted by the college at the end of each semester.
      There are several courses including one open course, one elective course,
      one mini project and one main project that spreads over a period of 6
      semesters. In addition to the computer hardware and software courses,
      subjects like Basic Mathematics, Management, Quantitative techniques and
      Technical Communication are also included. Laboratory work is an integral
      part of this programme. The UG and PG students are trained on Windows and
      LINUX platforms and in various high level languages and packages.
    </p>
    <p class="font-medium text-2xl mb-8 text-gray-800">Faculty</p>
    <div class="">
      <div class="max-w-[400px] w-full">
        {
          staff.map((item) => (
            <TeachersList client:load name={item.name} post={item.post} />
          ))
        }
      </div>
    </div>
  </div>
</Layout>
