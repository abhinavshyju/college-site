---
import AdminLayout from "@/layouts/AdminLayout.astro";
if (!Astro.locals.session) {
  return Astro.redirect("/");
}
---

<AdminLayout>
  <section class="mx-auto max-w-6xl px-4 py-10">
    <header class="mb-8">
      <h1 class="text-2xl font-semibold tracking-tight">Manage Academics</h1>
      <p class="text-muted-foreground mt-1">
        Manage academic programs and departments.
      </p>
    </header>

    <div class="grid gap-6 sm:grid-cols-2">
      <a
        href="/admin/academics/programs"
        class="group rounded-xl border bg-card p-6 shadow-sm transition hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
        <div
          class="mb-3 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary"
        >
          <span aria-hidden="true">📚</span>
        </div>
        <h2 class="font-medium">Manage Programs</h2>
        <p class="text-muted-foreground mt-1 text-sm">
          Add, edit, and manage academic programs and courses.
        </p>
      </a>

      <a
        href="/admin/academics/departments"
        class="group rounded-xl border bg-card p-6 shadow-sm transition hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
        <div
          class="mb-3 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary"
        >
          <span aria-hidden="true">🏢</span>
        </div>
        <h2 class="font-medium">Manage Departments</h2>
        <p class="text-muted-foreground mt-1 text-sm">
          Add, edit, and manage academic departments and faculty.
        </p>
      </a>
    </div>
  </section>
</AdminLayout>
