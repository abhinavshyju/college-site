---
import Layout from "@/layouts/Layout.astro";
import { isAdmin } from "@/middlewares/auth";

if (!(await isAdmin(Astro))) {
  return Astro.redirect("/login");
}
---

<Layout>
  <div class="container mx-auto px-4 py-8 max-w-7xl">
    <h1 class="text-3xl font-bold mb-8">Admin Dashboard</h1>

    <div class="grid md:grid-cols-2 gap-8">
      <a
        href="/admin/placement"
        class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow"
      >
        <h2 class="text-2xl font-semibold mb-2">Placement Management</h2>
        <p class="text-gray-600">Manage student placement records and images</p>
      </a>

      <a
        href="/admin/events"
        class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow"
      >
        <h2 class="text-2xl font-semibold mb-2">Event Management</h2>
        <p class="text-gray-600">Manage college events and activities</p>
      </a>
    </div>
  </div>
</Layout>
