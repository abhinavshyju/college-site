---
import AdminLayout from "@/layouts/AdminLayout.astro";
if (!Astro.locals.session) {
  return Astro.redirect("/");
}
---

<AdminLayout>
  <section class="mx-auto max-w-6xl px-4 py-10">
    <header class="mb-8">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-semibold tracking-tight">
            Manage Departments
          </h1>
          <p class="text-muted-foreground mt-1">
            Add, edit, and manage academic departments and faculty.
          </p>
        </div>
        <button
          id="add-department-btn"
          class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50"
        >
          Add Department
        </button>
      </div>
    </header>

    <div class="rounded-lg border bg-card">
      <div class="p-6">
        <div id="departments-list" class="space-y-4">
        </div>
      </div>
    </div>
  </section>

  <div id="department-modal" class="fixed inset-0 z-50 hidden bg-black/50">
    <div class="flex min-h-full items-center justify-center p-4">
      <div class="w-full max-w-2xl rounded-lg bg-white p-6 shadow-lg">
        <div class="mb-4 flex items-center justify-between">
          <h2 id="modal-title" class="text-lg font-semibold">Add Department</h2>
          <button id="close-modal" class="text-gray-400 hover:text-gray-600">
            <svg
              class="h-6 w-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <form id="department-form" class="space-y-4">
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700"
              >Department Name</label
            >
            <input
              type="text"
              id="name"
              name="name"
              required
              class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-primary focus:outline-none focus:ring-primary"
            />
          </div>

          <div>
            <label for="hod" class="block text-sm font-medium text-gray-700"
              >Head of Department</label
            >
            <input
              type="text"
              id="hod"
              name="hod"
              required
              class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-primary focus:outline-none focus:ring-primary"
            />
          </div>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label
                for="faculty"
                class="block text-sm font-medium text-gray-700"
                >Number of Faculty</label
              >
              <input
                type="number"
                id="faculty"
                name="faculty"
                required
                min="1"
                class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-primary focus:outline-none focus:ring-primary"
              />
            </div>
            <div>
              <label for="labs" class="block text-sm font-medium text-gray-700"
                >Number of Labs</label
              >
              <input
                type="number"
                id="labs"
                name="labs"
                required
                min="0"
                class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-primary focus:outline-none focus:ring-primary"
              />
            </div>
          </div>

          <div>
            <label
              for="description"
              class="block text-sm font-medium text-gray-700">Description</label
            >
            <textarea
              id="description"
              name="description"
              rows="3"
              class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-primary focus:outline-none focus:ring-primary"
            ></textarea>
          </div>

          <div>
            <label
              for="specializations"
              class="block text-sm font-medium text-gray-700"
              >Specializations (one per line)</label
            >
            <textarea
              id="specializations"
              name="specializations"
              rows="4"
              placeholder="Enter specializations, one per line"
              class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-primary focus:outline-none focus:ring-primary"
            ></textarea>
          </div>

          <div class="flex justify-end space-x-3">
            <button
              type="button"
              id="cancel-btn"
              class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-primary"
            >
              Cancel
            </button>
            <button
              type="submit"
              class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-primary"
            >
              Save Department
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script type="module">
    let departments = [];
    let editingDepartment = null;

    async function loadDepartments() {
      try {
        const response = await fetch("/api/admin/academics/departments");
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        departments = await response.json();
        renderDepartments();
      } catch (error) {
        console.error("Error loading departments:", error);
        showNotification("Error loading departments", "error");
      }
    }

    function renderDepartments() {
      const container = document.getElementById("departments-list");
      if (departments.length === 0) {
        container.innerHTML =
          '<p class="text-center text-gray-500 py-8">No departments found. Add your first department!</p>';
        return;
      }

      container.innerHTML = departments
        .map(
          (department) => `
        <div class="rounded-lg border bg-white p-4">
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <h3 class="text-lg font-semibold">${department.name}</h3>
              <div class="mt-2 grid grid-cols-2 gap-4 text-sm text-gray-600">
                <div><span class="font-medium">HOD:</span> ${department.hod}</div>
                <div><span class="font-medium">Faculty:</span> ${department.faculty}</div>
                <div><span class="font-medium">Labs:</span> ${department.labs}</div>
                <div><span class="font-medium">Specializations:</span> ${department.specializations ? department.specializations.length : 0}</div>
              </div>
              ${department.description ? `<p class="mt-2 text-sm text-gray-600">${department.description}</p>` : ""}
              ${
                department.specializations &&
                department.specializations.length > 0
                  ? `
                <div class="mt-2">
                  <span class="text-sm font-medium text-gray-700">Specializations:</span>
                  <div class="mt-1 flex flex-wrap gap-1">
                    ${department.specializations
                      .map(
                        (spec) => `
                      <span class="inline-flex items-center rounded-full bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700">
                        ${spec}
                      </span>
                    `
                      )
                      .join("")}
                  </div>
                </div>
              `
                  : ""
              }
            </div>
            <div class="ml-4 flex space-x-2">
              <button
                data-department-id="${department.id}"
                class="edit-department-btn rounded-md bg-blue-50 px-3 py-1 text-sm font-medium text-blue-700 hover:bg-blue-100"
              >
                Edit
              </button>
              <button
                data-department-id="${department.id}"
                class="delete-department-btn rounded-md bg-red-50 px-3 py-1 text-sm font-medium text-red-700 hover:bg-red-100"
              >
                Delete
              </button>
            </div>
          </div>
        </div>
      `
        )
        .join("");

      addButtonEventListeners();
    }

    function addButtonEventListeners() {
      // Edit buttons
      document.querySelectorAll(".edit-department-btn").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const id = e.target.getAttribute("data-department-id");
          editDepartment(id);
        });
      });

      // Delete buttons
      document.querySelectorAll(".delete-department-btn").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const id = e.target.getAttribute("data-department-id");
          deleteDepartment(id);
        });
      });
    }

    // Add department
    function addDepartment() {
      editingDepartment = null;
      document.getElementById("modal-title").textContent = "Add Department";
      document.getElementById("department-form").reset();
      document.getElementById("department-modal").classList.remove("hidden");
    }

    // Edit department
    function editDepartment(id) {
      const department = departments.find((d) => d.id === id);
      if (!department) {
        showNotification("Department not found", "error");
        return;
      }

      editingDepartment = department;
      document.getElementById("modal-title").textContent = "Edit Department";

      // Fill form
      document.getElementById("name").value = department.name;
      document.getElementById("hod").value = department.hod;
      document.getElementById("faculty").value = department.faculty;
      document.getElementById("labs").value = department.labs;
      document.getElementById("description").value =
        department.description || "";
      document.getElementById("specializations").value =
        department.specializations ? department.specializations.join("\n") : "";

      document.getElementById("department-modal").classList.remove("hidden");
    }

    // Delete department
    async function deleteDepartment(id) {
      if (!confirm("Are you sure you want to delete this department?")) return;

      try {
        const response = await fetch(`/api/admin/academics/departments/${id}`, {
          method: "DELETE",
        });

        if (response.ok) {
          departments = departments.filter((d) => d.id !== id);
          renderDepartments();
          showNotification("Department deleted successfully", "success");
        } else {
          const errorText = await response.text();
          throw new Error(errorText || "Failed to delete department");
        }
      } catch (error) {
        console.error("Error deleting department:", error);
        showNotification(
          "Error deleting department: " + error.message,
          "error"
        );
      }
    }

    // Save department
    async function saveDepartment(formData) {
      const departmentData = {
        name: formData.get("name"),
        hod: formData.get("hod"),
        faculty: parseInt(formData.get("faculty")),
        labs: parseInt(formData.get("labs")),
        description: formData.get("description") || null,
        specializations: formData.get("specializations")
          ? formData
              .get("specializations")
              .split("\n")
              .filter((line) => line.trim())
          : null,
      };

      try {
        const url = editingDepartment
          ? `/api/admin/academics/departments/${editingDepartment.id}`
          : "/api/admin/academics/departments";

        const method = editingDepartment ? "PUT" : "POST";

        const response = await fetch(url, {
          method,
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(departmentData),
        });

        if (response.ok) {
          document.getElementById("department-modal").classList.add("hidden");
          loadDepartments();
          showNotification(
            editingDepartment
              ? "Department updated successfully"
              : "Department created successfully",
            "success"
          );
        } else {
          const errorText = await response.text();
          throw new Error(errorText || "Failed to save department");
        }
      } catch (error) {
        console.error("Error saving department:", error);
        showNotification("Error saving department: " + error.message, "error");
      }
    }

    // Show notification
    function showNotification(message, type = "info") {
      const notification = document.createElement("div");
      notification.className = `fixed top-4 right-4 z-50 p-4 rounded-md shadow-lg ${
        type === "success"
          ? "bg-green-100 text-green-800 border border-green-200"
          : type === "error"
            ? "bg-red-100 text-red-800 border border-red-200"
            : "bg-blue-100 text-blue-800 border border-blue-200"
      }`;
      notification.textContent = message;

      document.body.appendChild(notification);

      setTimeout(() => {
        if (notification.parentNode) {
          notification.parentNode.removeChild(notification);
        }
      }, 3000);
    }

    document
      .getElementById("add-department-btn")
      .addEventListener("click", addDepartment);
    document.getElementById("close-modal").addEventListener("click", () => {
      document.getElementById("department-modal").classList.add("hidden");
    });
    document.getElementById("cancel-btn").addEventListener("click", () => {
      document.getElementById("department-modal").classList.add("hidden");
    });
    document
      .getElementById("department-form")
      .addEventListener("submit", (e) => {
        e.preventDefault();
        saveDepartment(new FormData(e.target));
      });

    document
      .getElementById("department-modal")
      .addEventListener("click", (e) => {
        if (e.target.id === "department-modal") {
          document.getElementById("department-modal").classList.add("hidden");
        }
      });

    loadDepartments();
  </script>
</AdminLayout>
