---
import AdminLayout from "@/layouts/AdminLayout.astro";
if (!Astro.locals.session) {
  return Astro.redirect("/");
}
---

<AdminLayout>
  <section class="mx-auto max-w-6xl px-4 py-10">
    <header class="mb-8">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-semibold tracking-tight">
            Manage Attendance
          </h1>
          <p class="text-muted-foreground mt-1">
            Add, edit, and manage attendance records and links.
          </p>
        </div>
        <button
          id="add-attendance-btn"
          class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50"
        >
          <span id="add-btn-text">Add Attendance</span>
        </button>
      </div>
    </header>

    <div class="rounded-lg border bg-card">
      <div class="p-6">
        <div id="attendance-list" class="space-y-4">
        </div>
      </div>
    </div>
  </section>

  <div id="attendance-modal" class="fixed inset-0 z-50 hidden bg-black/50">
    <div class="flex min-h-full items-center justify-center p-4">
      <div class="w-full max-w-lg rounded-lg bg-white p-6 shadow-lg">
        <div class="mb-4 flex items-center justify-between">
          <h2 id="modal-title" class="text-lg font-semibold">Add Attendance</h2>
          <button id="close-modal" class="text-gray-400 hover:text-gray-600">
            <svg
              class="h-6 w-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <form id="attendance-form" class="space-y-4">
          <div>
            <label for="title" class="block text-sm font-medium text-gray-700"
              >Title</label
            >
            <input
              type="text"
              id="title"
              name="title"
              required
              class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-primary focus:outline-none focus:ring-primary"
            />
          </div>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <div>
              <label for="level" class="block text-sm font-medium text-gray-700"
                >Level</label
              >
              <select
                id="level"
                name="level"
                required
                class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-primary focus:outline-none focus:ring-primary"
              >
                <option value="">Select Level</option>
                <option value="Undergraduate">Undergraduate</option>
                <option value="Postgraduate">Postgraduate</option>
              </select>
            </div>

            <div>
              <label
                for="program"
                class="block text-sm font-medium text-gray-700"
                >Program/Class</label
              >
              <select
                id="program"
                name="program"
                required
                class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-primary focus:outline-none focus:ring-primary"
              >
                <option value="">Select Program</option>
              </select>
            </div>

            <div>
              <label for="batch" class="block text-sm font-medium text-gray-700"
                >Batch (Year)</label
              >
              <select
                id="batch"
                name="batch"
                required
                class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-primary focus:outline-none focus:ring-primary"
              >
                <option value="">Select Batch</option>
                <option value="2021-2024">2021-2024</option>
                <option value="2022-2025">2022-2025</option>
                <option value="2023-2026">2023-2026</option>
                <option value="2024-2028">2024-2028</option>
                <option value="2025-2029">2025-2029</option>
              </select>
            </div>

            <div>
              <label
                for="semester"
                class="block text-sm font-medium text-gray-700">Semester</label
              >
              <select
                id="semester"
                name="semester"
                required
                class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-primary focus:outline-none focus:ring-primary"
              >
                <option value="">Select Semester</option>
                <option value="Semester 1">Semester 1</option>
                <option value="Semester 2">Semester 2</option>
                <option value="Semester 3">Semester 3</option>
                <option value="Semester 4">Semester 4</option>
                <option value="Semester 5">Semester 5</option>
                <option value="Semester 6">Semester 6</option>
                <option value="Semester 7">Semester 7</option>
                <option value="Semester 8">Semester 8</option>
              </select>
            </div>
          </div>

          <div>
            <label
              for="description"
              class="block text-sm font-medium text-gray-700">Description</label
            >
            <textarea
              id="description"
              name="description"
              rows="3"
              class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-primary focus:outline-none focus:ring-primary"
            ></textarea>
          </div>

          <div>
            <label for="file" class="block text-sm font-medium text-gray-700"
              >Upload PDF (Optional)</label
            >
            <input
              type="file"
              id="file"
              name="file"
              accept="application/pdf"
              class="mt-1 block w-full text-sm text-gray-500 file:mr-4 file:rounded-md file:border-0 file:bg-primary file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-primary/90"
            />
            <div id="current-file-container" class="mt-2 hidden">
              <p class="text-sm text-gray-600">
                Current file:
                <a
                  id="current-file-link"
                  href="#"
                  target="_blank"
                  class="text-blue-600 hover:underline">View PDF</a
                >
              </p>
            </div>
            <p class="mt-1 text-xs text-gray-500">
              Upload attendance sheet (PDF only). Leave empty to keep existing
              file.
            </p>
          </div>

          <div>
            <label for="link" class="block text-sm font-medium text-gray-700"
              >External Link (Optional)</label
            >
            <input
              type="url"
              id="link"
              name="link"
              placeholder="https://..."
              class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-primary focus:outline-none focus:ring-primary"
            />
          </div>

          <div>
            <label for="date" class="block text-sm font-medium text-gray-700"
              >Date</label
            >
            <input
              type="date"
              id="date"
              name="date"
              required
              class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-primary focus:outline-none focus:ring-primary"
            />
          </div>

          <div class="flex justify-end space-x-3">
            <button
              type="button"
              id="cancel-btn"
              class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-primary"
            >
              Cancel
            </button>
            <button
              type="submit"
              class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-primary"
            >
              Save Attendance
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script type="module">
    let attendanceRecords = [];
    let programs = [];
    let editingRecord = null;
    let isLoading = false;

    async function loadPrograms() {
      try {
        const response = await fetch("/api/admin/academics/programs");
        if (response.ok) {
          programs = await response.json();
          updateProgramDropdown();
        }
      } catch (error) {
        console.error("Error loading programs:", error);
      }
    }

    function updateProgramDropdown() {
      const levelSelect = document.getElementById("level");
      const programSelect = document.getElementById("program");
      const selectedLevel = levelSelect.value;

      programSelect.innerHTML = '<option value="">Select Program</option>';

      const filteredPrograms = selectedLevel
        ? programs.filter((p) => p.level === selectedLevel)
        : programs;

      filteredPrograms.forEach((p) => {
        const option = document.createElement("option");
        option.value = p.name;
        option.textContent = p.name;
        programSelect.appendChild(option);
      });
    }

    document
      .getElementById("level")
      .addEventListener("change", updateProgramDropdown);

    async function loadAttendance() {
      if (isLoading) return;

      isLoading = true;
      const container = document.getElementById("attendance-list");
      const addBtn = document.getElementById("add-attendance-btn");
      const addBtnText = document.getElementById("add-btn-text");

      container.innerHTML =
        '<div class="flex items-center justify-center py-8"><div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div><span class="ml-2 text-gray-600">Loading records...</span></div>';
      addBtn.disabled = true;
      addBtnText.textContent = "Loading...";

      try {
        const response = await fetch("/api/admin/academics/attendance");
        attendanceRecords = await response.json();
        renderAttendance();
      } catch (error) {
        console.error("Error loading attendance:", error);
        container.innerHTML =
          '<p class="text-center text-red-500 py-8">Error loading records. Please try again.</p>';
      } finally {
        isLoading = false;
        addBtn.disabled = false;
        addBtnText.textContent = "Add Attendance";
      }
    }

    function renderAttendance() {
      const container = document.getElementById("attendance-list");
      if (attendanceRecords.length === 0) {
        container.innerHTML =
          '<p class="text-center text-gray-500 py-8">No attendance records found. Add your first record!</p>';
        return;
      }

      container.innerHTML = attendanceRecords
        .map(
          (record) => `
        <div class="rounded-lg border bg-white p-4">
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-1">
                <span class="inline-flex items-center rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-medium text-blue-800">
                  ${record.program}
                </span>
                <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-800">
                  ${record.semester}
                </span>
              </div>
              <h3 class="text-lg font-semibold">${record.title}</h3>
              <p class="text-sm text-gray-500 mb-2">${new Date(record.date).toLocaleDateString()}</p>
              ${record.description ? `<p class="text-sm text-gray-600 mb-2">${record.description}</p>` : ""}
              ${
                record.link
                  ? `<a href="${record.link}" target="_blank" class="text-sm text-blue-600 hover:underline flex items-center gap-1">
                      View Document
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                    </a>`
                  : ""
              }
            </div>
            <div class="ml-4 flex space-x-2">
              <button
                onclick="editAttendance('${record.id}')"
                class="rounded-md bg-blue-50 px-3 py-1 text-sm font-medium text-blue-700 hover:bg-blue-100"
              >
                Edit
              </button>
              <button
                onclick="deleteAttendance('${record.id}')"
                class="rounded-md bg-red-50 px-3 py-1 text-sm font-medium text-red-700 hover:bg-red-100"
              >
                Delete
              </button>
            </div>
          </div>
        </div>
      `,
        )
        .join("");
    }

    // Add attendance
    function addAttendance() {
      if (isLoading) return;

      editingRecord = null;
      document.getElementById("modal-title").textContent = "Add Attendance";
      document.getElementById("attendance-form").reset();
      document.getElementById("date").valueAsDate = new Date();
      updateProgramDropdown();

      document.getElementById("current-file-container").classList.add("hidden");

      document.getElementById("attendance-modal").classList.remove("hidden");
    }

    // Edit attendance
    function editAttendance(id) {
      const record = attendanceRecords.find((r) => r.id === id);
      if (!record) return;

      editingRecord = record;
      document.getElementById("modal-title").textContent = "Edit Attendance";

      document.getElementById("title").value = record.title;
      document.getElementById("description").value = record.description || "";
      document.getElementById("link").value = record.link || "";
      document.getElementById("level").value = record.level || "";
      updateProgramDropdown();
      document.getElementById("program").value = record.program || "";
      document.getElementById("batch").value = record.batch || "";
      document.getElementById("semester").value = record.semester || "";
      document.getElementById("date").value = new Date(record.date)
        .toISOString()
        .split("T")[0];

      const fileContainer = document.getElementById("current-file-container");
      const fileLink = document.getElementById("current-file-link");

      if (record.link && record.link.includes("supabase")) {
        fileLink.href = record.link;
        fileContainer.classList.remove("hidden");
      } else {
        fileContainer.classList.add("hidden");
      }

      document.getElementById("attendance-modal").classList.remove("hidden");
    }

    async function deleteAttendance(id) {
      if (!confirm("Are you sure you want to delete this record?")) return;

      const deleteBtn = event.target;
      const originalText = deleteBtn.textContent;
      deleteBtn.disabled = true;
      deleteBtn.textContent = "Deleting...";
      deleteBtn.classList.add("opacity-50", "cursor-not-allowed");

      try {
        const response = await fetch(`/api/admin/academics/attendance/${id}`, {
          method: "DELETE",
        });

        if (response.ok) {
          attendanceRecords = attendanceRecords.filter((r) => r.id !== id);
          renderAttendance();
        } else {
          alert("Error deleting record");
        }
      } catch (error) {
        console.error("Error deleting record:", error);
        alert("Error deleting record");
      } finally {
        deleteBtn.disabled = false;
        deleteBtn.textContent = originalText;
        deleteBtn.classList.remove("opacity-50", "cursor-not-allowed");
      }
    }

    window.editAttendance = editAttendance;
    window.deleteAttendance = deleteAttendance;

    async function saveAttendance(formData) {
      const saveBtn = document.querySelector(
        '#attendance-form button[type="submit"]',
      );
      const originalText = saveBtn.textContent;

      saveBtn.disabled = true;
      saveBtn.textContent = editingRecord ? "Updating..." : "Saving...";
      saveBtn.classList.add("opacity-50", "cursor-not-allowed");

      try {
        const url = editingRecord
          ? `/api/admin/academics/attendance/${editingRecord.id}`
          : "/api/admin/academics/attendance";

        const method = editingRecord ? "PUT" : "POST";

        const response = await fetch(url, {
          method,
          body: formData, 
        });

        if (response.ok) {
          document.getElementById("attendance-modal").classList.add("hidden");
          loadAttendance();
        } else {
          alert("Error saving record");
        }
      } catch (error) {
        console.error("Error saving record:", error);
        alert("Error saving record");
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = originalText;
        saveBtn.classList.remove("opacity-50", "cursor-not-allowed");
      }
    }

    document
      .getElementById("add-attendance-btn")
      .addEventListener("click", addAttendance);
    document.getElementById("close-modal").addEventListener("click", () => {
      document.getElementById("attendance-modal").classList.add("hidden");
    });
    document.getElementById("cancel-btn").addEventListener("click", () => {
      document.getElementById("attendance-modal").classList.add("hidden");
    });
    document
      .getElementById("attendance-form")
      .addEventListener("submit", (e) => {
        e.preventDefault();
        saveAttendance(new FormData(e.target));
      });
    document
      .getElementById("attendance-modal")
      .addEventListener("click", (e) => {
        if (e.target.id === "attendance-modal") {
          document.getElementById("attendance-modal").classList.add("hidden");
        }
      });

    loadPrograms();
    loadAttendance();
  </script>
</AdminLayout>
