---
import Layout from "@/layouts/Layout.astro";
import { isAdmin } from "@/middlewares/auth";

if (!(await isAdmin(Astro))) {
  return Astro.redirect("/login");
}
---

<Layout>
  <div class="container mx-auto px-4 py-8 max-w-7xl">
    <div class="flex items-center justify-between mb-8">
      <h1 class="text-3xl font-bold">Placement Management</h1>
      <a href="/admin" class="text-primary hover:underline">Back to Dashboard</a
      >
    </div>

    <div class="bg-white rounded-lg shadow-lg p-6">
      <form id="placementForm" class="space-y-4">
        <div>
          <label class="block text-sm font-medium mb-1">Student Name</label>
          <input
            type="text"
            name="studentName"
            required
            class="w-full rounded border p-2"
          />
        </div>

        <div>
          <label class="block text-sm font-medium mb-1">Company Name</label>
          <input
            type="text"
            name="companyName"
            required
            class="w-full rounded border p-2"
          />
        </div>

        <div>
          <label class="block text-sm font-medium mb-1">Student Image</label>
          <input
            type="file"
            name="image"
            accept="image/*"
            required
            class="w-full"
          />
        </div>

        <button
          type="submit"
          class="bg-primary text-white px-4 py-2 rounded hover:bg-primary/90"
        >
          Add Placement
        </button>
      </form>

      <div id="placementsList" class="mt-8 space-y-4">
        <!-- Placements will be loaded here -->
      </div>
    </div>
  </div>

  <script>
    // Get form element
    const placementForm = document.getElementById("placementForm");

    // Handle form submission
    placementForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const form = e.target;
      const formData = new FormData(form as HTMLFormElement);

      try {
        // Submit form data to API endpoint
        const response = await fetch("/api/admin/placements", {
          method: "POST",
          body: formData,
        });

        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.error || "Failed to add placement");
        }

        // Reset form and reload placements on success
        (form as HTMLFormElement).reset();
        loadPlacements();
        alert("Placement added successfully!");
      } catch (error) {
        console.error("Error:", error);
        alert(
          error instanceof Error ? error.message : "Failed to add placement"
        );
      }
    });

    // Function to load placements from API
    async function loadPlacements() {
      try {
        const response = await fetch("/api/admin/placements");
        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.error || "Failed to load placements");
        }

        const placements = result.placements;
        const placementsList = document.getElementById("placementsList");
        if (!placementsList) return;

        // Inside the loadPlacements function
        placementsList.innerHTML = placements
          .map(
            (placement: {
              public_image_url: any;
              student_name: any;
              company_name: any;
              id: any;
            }) => `
            <div class="border rounded p-4 flex items-center justify-between">
              <div class="flex items-center">
                <img 
                  src="${placement.public_image_url}" 
                  alt="${placement.student_name}" 
                  class="w-16 h-16 object-cover rounded-full mr-4"
                />
                <div>
                  <h3 class="font-medium">${placement.student_name}</h3>
                  <p class="text-gray-600">${placement.company_name}</p>
                </div>
              </div>
              <button 
                class="text-red-600 hover:text-red-800"
                data-id="${placement.id}"
              >
                Delete
              </button>
            </div>
          `
          )
          .join("");

        document.querySelectorAll("#placementsList button").forEach((btn) => {
          btn.addEventListener("click", () => {
            const id = btn.getAttribute("data-id");
            deletePlacement(id);
          });
        });
      } catch (error) {
        console.error("Error loading placements:", error);
      }
    }

    // Function to delete a placement
    async function deletePlacement(id: string | null) {
      if (!confirm("Are you sure you want to delete this placement?")) return;

      try {
        const response = await fetch(`/api/admin/placements?id=${id}`, {
          method: "DELETE",
        });

        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.error || "Failed to delete placement");
        }

        loadPlacements();
      } catch (error) {
        console.error("Error deleting placement:", error);
        alert(
          error instanceof Error ? error.message : "Failed to delete placement"
        );
      }
    }

    // Load placements when page loads
    document.addEventListener("DOMContentLoaded", loadPlacements);
  </script>
</Layout>
